{
  "name": "baaki",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.7.0",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty",
    "dev": "pnpm --filter @baaki/dashboard dev",
    "build:packages": "tsc -b packages/core",
    "webhook": "tsx apps/webhook/src/server.ts",
    "tunnel": "cloudflared tunnel --url http://localhost:3001",
    "voice": "tsx apps/voice/src/server.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "ws": "^8.21.3"
  }
}
